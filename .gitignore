# Godot 4
.godot/
/android/
/build/
# export_presets.cfg is committed on purpose: CI (release.yml) needs it to
# know what/how to export. It carries no secrets — the itch.io key is a
# GitHub Actions secret, never in this file.
*.translation
combat_screen.png*
actionbar_screen.png*
lpc_spike.png*
lpc_spike_credits.png*
__pycache__/
world_screen.png*
world_turned.png*
icon_sheet.png*
figures_screen.png*
# Every dev screenshot script's output folder (tests/shot_*.gd write to
# shots_<name>/). One pattern, so a PR adding a shot script needs no line here:
# a line per folder at this spot made every two such PRs conflict.
shots_*/
figures_idle_*.png
move_sequence.png
idle_sequence.png
# tests/shot_settlement_kit.gd output — dev-only renders, same as the rest here
kit_gallery_*.png*
kit_variety.png*
kit_vs_glb.png*
# tests/shot_lair_kit.gd output
lair_kit_gallery.png*
lair_kit_vs_glb.png*
# tests/shot_beast_gallery.gd output
beast_gallery.png*
# tests/shot_damage.gd output
damage_numbers.png*
/assets/NewlyDownloadedModels/*
# tests/shot_spoils.gd output
spoils_*.png*
# tests/shot_height.gd output
height_board.png*
# tests/shot_strip.gd output
combat_strip.png*
# tests/shot_biomes.gd output
/biome_*.png*

# tests/shot_climb.gd output
/climb_*.png*
/props_gallery.png*
/board_downs.png*
/board_marsh.png*
/combat_card.png*
